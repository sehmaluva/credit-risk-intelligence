# Example environment variables for Credit Risk Intelligence
# Copy to `.env` and fill with real secrets for local/dev/prod.
# Do NOT commit real secrets to version control.

# Django settings
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod

# Hosts / CORS (comma-separated lists)
ALLOWED_HOSTS=localhost,127.0.0.1,frontend_address
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: either set DATABASE_URL or individual DB_* values used by docker-compose
# Example DATABASE_URL: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://dbuser:dbpassword@db_host_address:5432/db_name
DB_HOST=your_db_host_address
DB_NAME=db_name
DB_USER=dbuser
DB_PASSWORD=dbpassword
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# ML artifacts path (where trained models/artifacts are stored)
ML_ARTIFACTS_PATH=../ml/artifacts

# Optional monitoring / email
SENTRY_DSN=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

